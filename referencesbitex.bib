	author = {Caremel, R. and Berthier, A. and Sentilhes, L. and Collard, P. and Grise, P.},
	urldate = {2026-11-19},
	date = {2008-09},
	langid = {french},
	file = {PDF:files/1057/Caremel et al. - 2008 - Analyse de la sexualité féminine dans une population féminine témoin française.pdf:application/pdf},
}


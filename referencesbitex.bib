	doi = {10.1007/s12611-014-0266-8},
	shorttitle = {Grossesse, dépression et anxiété},
	abstract = {Les problèmes de santé mentale sont fréquents durant la période périnatale et entraînent des conséquences obstétricales, néonatales et neurodéveloppementales. Le dépistage et l’accès aux soins des patientes souffrant de ces conditions demeurent pourtant limités. Le but de cet article est de cerner la trajectoire clinique des femmes souffrant d’anxiété et/ou de dépression périnatale et de faire un survol des traitements médicaux et non médicaux actuels en considérant les risques associés autant à la psychopathologie non traitée qu’à la psychopharmacothérapie.},
